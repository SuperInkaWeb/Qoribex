---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
// Importamos el componente Navbar reutilizable
import Navbar from '../components/Navbar.astro';

// Importar Estilos CSS Externos
import '../styles/home.css';

// ==========================================
// 1. IMPORTACIÓN DE ACTIVOS
// ==========================================
import heroImg from '../assets/hero-image.png';

// Redes Sociales (Assets)
import logoFb from '../assets/logos/logo-facebook.png';
import logoIg from '../assets/logos/logo-instagram.jpg';
import logoLi from '../assets/logos/logo-linkdin.png';
import logoX from '../assets/logos/logo-x.png';
import logoYt from '../assets/logos/logo-yt.png';
// ==========================================
// 2. DATOS DE SERVICIOS
// ==========================================
import serv8 from '../assets/servicios/animacion-digital.jpg';
