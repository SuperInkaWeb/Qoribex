const servicios = [
    { img: serv8, title: "Animación digital y motion graphics", link: "/servicios/animacion-digital" },
    { img: serv9, title: "Comunicación y periodismo corporativo", link: "/servicios/comunicacion-corporativa" },
    { img: serv10, title: "Branding y diseño gráfico", link: "/servicios/branding-diseno" },
    { img: serv11, title: "Diseño digital y web", link: "/servicios/diseno-web" },
    { img: serv12, title: "IRL y experiencias en vivo", link: "/servicios/irl-experiencias" },
    { img: serv13, title: "Marketing digital y ventas", link: "/servicios/marketing-digital" },
    { img: serv14, title: "Podcast y producción de contenido sonoro", link: "/servicios/podcast" },
    { img: serv15, title: "Producción audiovisual", link: "/servicios/produccion-audiovisual" },
    { img: serv16, title: "Producción gráfica y publicitaria", link: "/servicios/produccion-grafica" },
];

const serviciosFooter = [
    "Branding y diseño gráfico",
    "Marketing digital y ventas",
    "Diseño digital y web",
    "Produccion audiovisual",
    "Comunicación y periodismo corporativo",
    "Animación digital y motion graphics",
    "IRL y experiencias en vivo",
    "Producción gráfica y publicitaria",
    "Podcast y producción de contenido sonoro"
];

// ==========================================
// 3. DATOS DE CLIENTES Y PORTAFOLIO
// ==========================================
import cli17 from '../assets/clientes/QORIBEX-17.jpg';
import cli18 from '../assets/clientes/QORIBEX-18.jpg';
import cli19 from '../assets/clientes/QORIBEX-19.jpg';
import cli20 from '../assets/clientes/QORIBEX-20.jpg';
import cli21 from '../assets/clientes/QORIBEX-21.jpg';
import cli22 from '../assets/clientes/QORIBEX-22.jpg';
import cli23 from '../assets/clientes/QORIBEX-23.jpg';
import cli24 from '../assets/clientes/QORIBEX-24.jpg';

const clientesBase = [cli24, cli19, cli21, cli22, cli18, cli17, cli23, cli20];
const clientes = [...clientesBase, ...clientesBase, ...clientesBase];

import portHistorias from '../assets/portafolio/QORIBEXhistorias-04.png';
import portPortadas from '../assets/portafolio/QORIBEX portadas mensuales-04.png';
import portArte from '../assets/portafolio/QORIBEX arteblog-04.png';
import portGraficas from '../assets/portafolio/QORIBEX piezas gráficas-04.png';
import portReels from '../assets/portafolio/QORIBEX reels-04.png';

const portfolioItems = [
    { img: portHistorias, title: "Historias", desc: "Storytelling visual", link: "#" },
    { img: portPortadas, title: "Portadas Mensuales", desc: "Diseño editorial", link: "/portafolio/portadas-mensuales" },
    { img: portArte, title: "Arte Blog", desc: "Ilustración digital", link: "/portafolio/arte-blog" },
    { img: portGraficas, title: "Piezas Gráficas", desc: "Branding", link: "#" },
    { img: portReels, title: "Reels", desc: "Edición dinámica", link: "/portafolio/reels" },
];

// ==========================================
// 4. DATOS ESTÁTICOS DE PAÍSES (OPTIMIZADO)
// ==========================================
const paises = [
    { code: 'EC', prefix: '+593', name: 'Ecuador', flag: '🇪🇨' },
    { code: 'AR', prefix: '+54', name: 'Argentina', flag: '🇦🇷' },
    { code: 'BO', prefix: '+591', name: 'Bolivia', flag: '🇧🇴' },
    { code: 'BR', prefix: '+55', name: 'Brasil', flag: '🇧🇷' },
    { code: 'CA', prefix: '+1', name: 'Canadá', flag: '🇨🇦' },
    { code: 'CL', prefix: '+56', name: 'Chile', flag: '🇨🇱' },
    { code: 'CO', prefix: '+57', name: 'Colombia', flag: '🇨🇴' },
    { code: 'CR', prefix: '+506', name: 'Costa Rica', flag: '🇨🇷' },
    { code: 'CU', prefix: '+53', name: 'Cuba', flag: '🇨🇺' },
    { code: 'SV', prefix: '+503', name: 'El Salvador', flag: '🇸🇻' },
    { code: 'ES', prefix: '+34', name: 'España', flag: '🇪🇸' },
    { code: 'US', prefix: '+1', name: 'Estados Unidos', flag: '🇺🇸' },
    { code: 'GT', prefix: '+502', name: 'Guatemala', flag: '🇬🇹' },
    { code: 'HN', prefix: '+504', name: 'Honduras', flag: '🇭🇳' },
    { code: 'MX', prefix: '+52', name: 'México', flag: '🇲🇽' },
    { code: 'NI', prefix: '+505', name: 'Nicaragua', flag: '🇳🇮' },
    { code: 'PA', prefix: '+507', name: 'Panamá', flag: '🇵🇦' },
    { code: 'PY', prefix: '+595', name: 'Paraguay', flag: '🇵🇾' },
    { code: 'PE', prefix: '+51', name: 'Perú', flag: '🇵🇪' },
    { code: 'DO', prefix: '+1', name: 'Rep. Dominicana', flag: '🇩🇴' },
    { code: 'UY', prefix: '+598', name: 'Uruguay', flag: '🇺🇾' },
    { code: 'VE', prefix: '+58', name: 'Venezuela', flag: '🇻🇪' }
];
---

<Layout title="Qoribex - Innovación, diseño y estrategia">

    <!-- SPLASH SCREEN -->
    <div id="intro-overlay" class="fixed inset-0 z-[100] bg-black flex items-center justify-center transition-opacity duration-700">
        <video id="intro-video" class="w-full h-full object-cover" muted playsinline>
            <source src="/videos/intro.mp4" type="video/mp4">
        </video>
        <button id="skip-intro" class="absolute bottom-8 right-8 text-white border border-white/50 bg-black/30 backdrop-blur-sm px-5 py-2 rounded-full text-sm font-medium hover:bg-white hover:text-black transition-all z-[101]">
            Saltar Intro
        </button>
    </div>

    <!-- NAVBAR COMPONENT -->
    <Navbar />

    <main class="opacity-0 transition-opacity duration-1000" id="main-content">

        <!-- HERO -->
        <section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden bg-[#f8faff] pt-24 md:pt-0">
            <div class="absolute inset-0 z-0 pointer-events-none">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-white to-blue-100 opacity-80"></div>
                <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(#1F23A3 1px, transparent 1px); background-size: 30px 30px;"></div>
                <div class="absolute -top-20 -right-20 w-[300px] md:w-[600px] h-[300px] md:h-[600px] bg-yellow-200/40 rounded-full mix-blend-multiply filter blur-[60px] md:blur-[80px] animate-blob"></div>
                <div class="absolute -top-20 -left-20 w-[300px] md:w-[600px] h-[300px] md:h-[600px] bg-blue-300/40 rounded-full mix-blend-multiply filter blur-[60px] md:blur-[80px] animate-blob animation-delay-2000"></div>
                <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-[300px] md:w-[600px] h-[300px] md:h-[600px] bg-purple-200/30 rounded-full mix-blend-multiply filter blur-[60px] md:blur-[80px] animate-blob animation-delay-4000"></div>
            </div>

            <div class="container mx-auto px-4 md:px-6 relative z-10 w-full h-full flex flex-col md:flex-row items-center justify-center min-h-[calc(100vh-100px)]">
                <div class="w-full md:w-5/12 lg:w-1/2 flex flex-col justify-center items-start space-y-6 md:space-y-8 animate-fade-in-up text-center md:text-left mb-10 md:mb-0 order-2 md:order-1">
                    <div class="inline-flex items-center gap-2 bg-[#1F23A3]/10 text-[#1F23A3] px-4 py-1.5 rounded-full text-xs md:text-sm font-bold tracking-wider mb-2 mx-auto md:mx-0 border border-[#1F23A3]/20">
                        <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
                        AGENCIA DIGITAL
                    </div>
                    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-[#1F23A3] leading-[1.1] tracking-tight">
                        Innovación, <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-600 relative">diseño y estrategia</span>
                    </h1>
                    <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-medium max-w-lg mx-auto md:mx-0">
                        Transformamos tus ideas en experiencias digitales que conectan, impactan y venden.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center md:justify-start">
                        <a href="#servicios" class="smooth-scroll group bg-[#1F23A3] text-white px-8 py-4 rounded-xl font-bold hover:bg-blue-800 transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-1 flex items-center justify-center gap-3 text-base">
                            Ver Servicios <span>↓</span>
                        </a>
                        <a href="#portafolio" class="smooth-scroll group border-2 border-[#1F23A3] text-[#1F23A3] px-8 py-4 rounded-xl font-bold hover:bg-[#1F23A3] hover:text-white transition-all duration-300 text-base text-center bg-white/50 backdrop-blur-sm flex items-center justify-center gap-2">
                            Nuestro Trabajo <span>→</span>
                        </a>
                    </div>
                </div>

                <div class="w-full md:w-7/12 lg:w-1/2 relative flex justify-center items-center order-1 md:order-2 h-[50vh] md:h-[85vh]">
                    <div class="relative w-full h-full flex items-center justify-center">
                        <Image
                                src={heroImg}
                                alt="Qoribex Hero"
                                class="relative z-10 w-full h-full object-contain drop-shadow-2xl hover:drop-shadow-[0_30px_50px_rgba(31,35,163,0.3)] transition-all duration-700 hover:scale-[1.05] rounded-[3rem]"
                                loading="eager"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN QUIÉNES SOMOS -->
        <section class="py-20 md:py-32 bg-white relative z-10">
            <div class="container mx-auto px-4 md:px-6 text-center max-w-5xl">
                <span class="text-yellow-500 font-bold tracking-widest text-sm uppercase mb-4 block">Sobre Nosotros</span>
                <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-[#1F23A3] mb-8 md:mb-12 tracking-tight">¿QUIÉNES SOMOS?</h2>
                <div class="prose prose-lg md:prose-xl mx-auto text-gray-600 leading-relaxed text-pretty">
                    <p>
                        En <strong class="text-[#1F23A3] font-black">QORIBEX</strong> somos una agencia de marketing digital y web que combina
                        creatividad, comunicación y tecnología para <strong class="text-[#1F23A3] bg-yellow-100 px-2 py-0.5 rounded">impulsar marcas</strong> al siguiente nivel.
                    </p>
                    <p class="mt-6">
                        Nuestro enfoque está orientado a generar resultados reales en ventas, branding y posicionamiento digital,
                        construyendo estrategias que conectan con las personas y transforman la <strong class="text-[#1F23A3]">presencia online</strong> en crecimiento tangible.
                    </p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-10 mt-16">
                    <div class="group p-8 border border-gray-100 rounded-3xl bg-white shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                        <h3 class="text-4xl md:text-5xl font-black text-[#1F23A3] mb-2">+150</h3>
                        <p class="text-gray-500 font-bold text-sm md:text-base uppercase">Proyectos Entregados</p>
                    </div>
                    <div class="group p-8 border border-gray-100 rounded-3xl bg-white shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                        <h3 class="text-4xl md:text-5xl font-black text-[#1F23A3] mb-2">+50</h3>
                        <p class="text-gray-500 font-bold text-sm md:text-base uppercase">Clientes Felices</p>
                    </div>
                    <div class="group p-8 border border-gray-100 rounded-3xl bg-white shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                        <h3 class="text-4xl md:text-5xl font-black text-[#1F23A3] mb-2">5A</h3>
                        <p class="text-gray-500 font-bold text-sm md:text-base uppercase">Años de Experiencia</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SERVICIOS -->
        <section id="servicios" class="py-20 md:py-32 bg-gray-50 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#1F23A3]/20 to-transparent"></div>
            <div class="container mx-auto px-4 md:px-6 relative z-10">
                
                <div class="text-center mb-16 md:mb-24">
                    <span class="text-yellow-500 font-bold tracking-widest text-sm uppercase">Lo que hacemos</span>
                    <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-[#1F23A3] mt-3 tracking-tight">NUESTRAS UNIDADES DE NEGOCIO</h2>
                    <p class="text-gray-600 mt-6 max-w-3xl mx-auto text-lg md:text-xl">Hemos estructurado nuestros servicios en <strong class="text-[#1F23A3]">3 áreas especializadas</strong> para resolver problemas reales, explorar oportunidades y construir soluciones viables.</p>
                    
                    <!-- UX: Índice visual de las 3 áreas -->
                    <div class="flex flex-wrap justify-center gap-3 sm:gap-4 mt-8">
                        <a href="#unidad-digital" class="smooth-scroll bg-[#1F23A3]/10 text-[#1F23A3] font-bold px-5 sm:px-6 py-2.5 sm:py-3 rounded-full hover:bg-[#1F23A3] hover:text-white transition-all duration-300 shadow-sm flex items-center gap-2 text-sm sm:text-base border border-[#1F23A3]/20">
                            <span class="bg-white rounded-full w-6 h-6 flex items-center justify-center text-[#1F23A3] text-sm">1</span> Digital
                        </a>
                        <a href="#unidad-future" class="smooth-scroll bg-yellow-100 text-yellow-800 font-bold px-5 sm:px-6 py-2.5 sm:py-3 rounded-full hover:bg-yellow-400 hover:text-[#1F23A3] transition-all duration-300 shadow-sm flex items-center gap-2 text-sm sm:text-base border border-yellow-200">
                            <span class="bg-white rounded-full w-6 h-6 flex items-center justify-center text-yellow-600 text-sm">2</span> Future Systems
                        </a>
                        <a href="#unidad-robotics" class="smooth-scroll bg-gray-200 text-gray-800 font-bold px-5 sm:px-6 py-2.5 sm:py-3 rounded-full hover:bg-gray-800 hover:text-white transition-all duration-300 shadow-sm flex items-center gap-2 text-sm sm:text-base border border-gray-300">
                            <span class="bg-white rounded-full w-6 h-6 flex items-center justify-center text-gray-800 text-sm">3</span> Robotics & Mechatronics
                        </a>
                    </div>
                </div>

                <!-- 1. Qoribex Digital -->
                <div id="unidad-digital" class="mb-24 scroll-mt-28">
                    <div class="mb-10 text-center md:text-left border-l-4 border-[#1F23A3] pl-4 md:pl-6 max-w-3xl mx-auto md:mx-0">
                        <h3 class="text-3xl font-black text-[#1F23A3] mb-2">Qoribex Digital</h3>
                        <p class="text-gray-600 font-medium text-lg md:text-xl">¿Cómo comunicamos mejor y construimos oportunidades comerciales?</p>
                        <p class="text-gray-500 mt-2">Marketing, presencia, comunicación y soluciones digitales.</p>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                        {servicios.filter(s => ["Diseño digital y web", "Marketing digital y ventas", "Animación digital y motion graphics", "Podcast y producción de contenido sonoro", "Producción audiovisual"].includes(s.title)).map((item) => (
                            <a href={item.link} class="group relative overflow-hidden rounded-2xl block shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 bg-white">
                                <Image src={item.img} alt={item.title} class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-[#1F23A3]/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6 z-10">
                                    <h4 class="text-white font-bold text-xl md:text-2xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 leading-tight">{item.title}</h4>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>

                <!-- 2. Qoribex Future Systems -->
                <div id="unidad-future" class="mb-24 scroll-mt-28">
                    <div class="mb-10 text-center md:text-left border-l-4 border-[#1F23A3] pl-4 md:pl-6 max-w-3xl mx-auto md:mx-0">
                        <h3 class="text-3xl font-black text-[#1F23A3] mb-2">Qoribex Future Systems</h3>
                        <p class="text-gray-600 font-medium text-lg md:text-xl">¿Qué debemos transformar, diseñar o validar?</p>
                        <p class="text-gray-500 mt-2">Estrategia, innovación, nuevos negocios y transformación corporativa.</p>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                        {servicios.filter(s => ["Branding y diseño gráfico", "Comunicación y periodismo corporativo"].includes(s.title)).map((item) => (
                            <a href={item.link} class="group relative overflow-hidden rounded-2xl block shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 bg-white">
                                <Image src={item.img} alt={item.title} class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-[#1F23A3]/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6 z-10">
                                    <h4 class="text-white font-bold text-xl md:text-2xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 leading-tight">{item.title}</h4>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>

                <!-- 3. Qoribex Robotics & Mechatronics -->
                <div id="unidad-robotics" class="scroll-mt-28">
                    <div class="mb-10 text-center md:text-left border-l-4 border-[#1F23A3] pl-4 md:pl-6 max-w-3xl mx-auto md:mx-0">
                        <h3 class="text-3xl font-black text-[#1F23A3] mb-2">Qoribex Robotics & Mechatronics</h3>
                        <p class="text-gray-600 font-medium text-lg md:text-xl">¿Cómo evaluamos una solución que interactúa con el mundo físico?</p>
                        <p class="text-gray-500 mt-2">Robótica, electrónica, sensores, control e integración física-digital.</p>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                        {servicios.filter(s => ["IRL y experiencias en vivo", "Producción gráfica y publicitaria"].includes(s.title)).map((item) => (
                            <a href={item.link} class="group relative overflow-hidden rounded-2xl block shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 bg-white">
                                <Image src={item.img} alt={item.title} class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-[#1F23A3]/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6 z-10">
                                    <h4 class="text-white font-bold text-xl md:text-2xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 leading-tight">{item.title}</h4>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>

            </div>
        </section>

        <!-- CLIENTES -->
        <section class="py-16 md:py-24 bg-white relative overflow-hidden">
            <div class="container mx-auto px-4 md:px-6 mb-12">
                <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-400 tracking-widest uppercase">Ellos confían en nosotros</h2>
            </div>

            <div class="relative w-full overflow-hidden group">
                <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-white to-transparent z-10"></div>
                <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-white to-transparent z-10"></div>
                <div class="flex animate-scroll whitespace-nowrap gap-12 md:gap-24 items-center">
                    {clientes.map((cliente) => (
                            <div class="w-32 md:w-48 flex-shrink-0 grayscale hover:grayscale-0 transition-all duration-500 cursor-pointer opacity-80 hover:opacity-100">
                                <Image src={cliente} alt="Cliente Qoribex" class="w-full h-auto object-contain mix-blend-multiply" />
                            </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- PORTAFOLIO -->
        <section id="portafolio" class="py-20 md:py-32 bg-[#0a0a0a] text-white overflow-hidden relative">
            <div class="absolute inset-0 opacity-30 stars"></div>
            <div class="container mx-auto px-4 md:px-6 mb-12 text-center relative z-10">
                <span class="text-yellow-400 font-bold tracking-widest text-sm uppercase">Galería</span>
                <h2 class="text-4xl sm:text-5xl md:text-6xl font-black mt-3">NUESTRO PORTAFOLIO</h2>
            </div>
            <div class="relative max-w-5xl mx-auto px-4 group z-10">
                <div class="overflow-hidden rounded-3xl aspect-square md:aspect-video">
                    <div id="slider-track" class="flex transition-transform duration-700 cubic-bezier(0.4, 0, 0.2, 1) h-full">
                        {portfolioItems.map((item) => (
                                <div class="w-full flex-shrink-0 relative h-full group/slide">
                                    <!-- Enlace que envuelve la imagen -->
                                    <a href={item.link} class={`block w-full h-full relative ${item.link === '#' ? 'cursor-default' : 'cursor-pointer'}`}>
                                        <Image src={item.img} alt={item.title} class="w-full h-full object-cover" />

                                        <!-- Overlay con texto (Visible siempre o en hover, según prefieras) -->
                                        <div class="absolute inset-0 bg-black/40 flex flex-col justify-end p-8 md:p-12 opacity-0 group-hover/slide:opacity-100 transition-opacity duration-300">
                                            <span class="text-yellow-400 font-bold tracking-widest uppercase text-sm mb-2">{item.desc}</span>
                                            <h3 class="text-3xl md:text-5xl font-black">{item.title}</h3>
                                            {item.link !== '#' && (
                                                    <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold border-b border-white w-max pb-1">
                                                Ver proyecto completo →
                                            </span>
                                            )}
                                        </div>
                                    </a>
                                </div>
                        ))}
                    </div>
                </div>
                <button id="prev-btn" class="absolute left-0 md:-left-6 top-1/2 -translate-y-1/2 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:bg-yellow-400 hover:text-[#1F23A3] hover:scale-110 transition-all duration-300 z-20 group focus:outline-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button id="next-btn" class="absolute right-0 md:-right-6 top-1/2 -translate-y-1/2 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:bg-yellow-400 hover:text-[#1F23A3] hover:scale-110 transition-all duration-300 z-20 group focus:outline-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </button>
                <div class="flex justify-center gap-3 mt-8">
                    {portfolioItems.map((_, index) => (
                            <button class="indicator-dot w-3 h-3 rounded-full bg-white/20 hover:bg-white transition-all duration-300 focus:outline-none" data-index={index} aria-label={`Ir a diapositiva ${index + 1}`}></button>
                    ))}
                </div>
            </div>
        </section>

        <!-- FOOTER (CON LAYOUT BALANCEADO Y SELECTOR DE PAÍSES) -->
        <footer id="contacto" class="bg-[#1F23A3] text-white pt-20 pb-10 relative overflow-hidden">
            <!-- Efectos de fondo originales -->
            <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500 rounded-full mix-blend-overlay filter blur-[100px] opacity-30 animate-pulse"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-purple-500 rounded-full mix-blend-overlay filter blur-[100px] opacity-20"></div>

            <div class="container mx-auto px-4 md:px-6 relative z-10 max-w-7xl">
                <!-- Layout balanceado (5/12 para form y 7/12 para info) -->
                <div class="flex flex-col lg:flex-row gap-12 md:gap-20 mb-20 border-b border-white/10 pb-16">
                    
                    <!-- Lado Izquierdo: Formularios de Contacto (HU3) -->
                    <div class="w-full lg:w-5/12 space-y-8">
                        <div>
                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight">¿Hablamos de tu <br><span class="text-yellow-400">próximo proyecto?</span></h2>
                            <p class="text-blue-100 text-lg mt-4 max-w-md leading-relaxed">Déjanos tus datos y nos pondremos en contacto contigo lo antes posible para hacer magia juntos.</p>
                        </div>
                        
                        <!-- Formulario de Captura de Datos -->
                       <form id="contactForm" class="bg-white/5 backdrop-blur-sm p-6 md:p-8 rounded-2xl border border-white/10 space-y-4 w-full">
                            <div>
                                <label for="name" class="block text-sm font-medium text-blue-100 mb-1">Nombre Completo</label>
                                <input type="text" id="name" name="name" required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-white placeholder-blue-200/50 focus:outline-none focus:border-yellow-400 focus:ring-1 focus:ring-yellow-400 transition-colors" placeholder="Ej. Juan Pérez">
                            </div>
                            
                            <div>
                                <label for="email" class="block text-sm font-medium text-blue-100 mb-1">Correo Electrónico</label>
                                <input type="email" id="email" name="email" required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-white placeholder-blue-200/50 focus:outline-none focus:border-yellow-400 focus:ring-1 focus:ring-yellow-400 transition-colors" placeholder="juan@ejemplo.com">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-blue-100 mb-1">Número de Teléfono</label>
                                <div class="flex gap-2">
                                    <select id="countryCode" name="countryCode" class="w-[120px] flex-shrink-0 bg-white/10 border border-white/20 rounded-lg px-2 py-3 text-white focus:outline-none focus:border-yellow-400 [&>option]:text-black transition-colors appearance-none text-center">
                                        {paises.map((pais, index) => (
                                            <option value={pais.prefix} selected={index === 0}>
                                                {pais.flag} {pais.prefix}
                                            </option>
                                        ))}
                                    </select>
                                    <input type="tel" id="phone" name="phone" required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-white placeholder-blue-200/50 focus:outline-none focus:border-yellow-400 focus:ring-1 focus:ring-yellow-400 transition-colors" placeholder="99 999 9999">
                                </div>
                            </div>
                            
                            <div>
                                <label for="service" class="block text-sm font-medium text-blue-100 mb-1">Servicio de Interés</label>
                                <select id="service" name="service" required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-yellow-400 [&>option]:text-black transition-colors appearance-none">
                                    <option value="" disabled selected>Selecciona un servicio...</option>
                                    {serviciosFooter.map((servicio) => (
                                        <option value={servicio}>{servicio}</option>
                                    ))}
                                </select>
                            </div>
                            
                            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                                <button type="submit" name="contactMethod" value="whatsapp" class="flex-1 bg-[#25D366] text-white font-bold text-base py-3.5 px-4 rounded-lg hover:bg-white hover:text-[#25D366] transition-all duration-300 shadow-lg hover:shadow-[#25D366]/20 transform hover:-translate-y-1 flex items-center justify-center gap-2">
                                    <span class="text-xl">💬</span> WhatsApp
                                </button>
                                <button type="submit" name="contactMethod" value="email" class="flex-1 bg-yellow-400 text-[#1F23A3] font-bold text-base py-3.5 px-4 rounded-lg hover:bg-white transition-all duration-300 shadow-lg hover:shadow-yellow-400/20 transform hover:-translate-y-1 flex items-center justify-center gap-2">
                                    <span class="text-xl">✉️</span> Correo
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Lado Derecho: Info Corporativa Espaciada -->
                    <div class="w-full lg:w-7/12 flex flex-col justify-between lg:pl-16 lg:pt-8 h-full mt-12 lg:mt-0">
                        
                        <div class="space-y-14">
                            <!-- Contacto Directo -->
                            <div>
                                <h4 class="text-yellow-400 font-bold mb-4 text-sm tracking-widest uppercase">Atención Directa</h4>
                                <div class="flex flex-col gap-4">
                                    <a href="mailto:hola@qoribex.com" class="inline-flex items-center gap-4 text-blue-100 hover:text-yellow-400 transition-colors text-lg group w-max">
                                        <span class="bg-white/10 w-12 h-12 flex items-center justify-center rounded-full group-hover:bg-yellow-400 group-hover:text-[#1F23A3] transition-colors">✉️</span> 
                                        hola@qoribex.com
                                    </a>
                                </div>
                            </div>
                            
                            <!-- Lista de Servicios -->
                            <div>
                                <h4 class="text-yellow-400 font-bold mb-6 text-sm tracking-widest uppercase">Servicios</h4>
                                <ul class="text-blue-100 space-y-4 text-sm md:text-base grid grid-cols-1 sm:grid-cols-2 gap-x-8">
                                    {serviciosFooter.map((servicio) => (
                                        <li class="hover:text-white transition-colors cursor-default flex items-start gap-2">
                                            <span class="text-yellow-400 mt-1">•</span>
                                            <span class="leading-tight">{servicio}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            
                            <!-- Redes Sociales rediseñadas -->
                            <div>
                                <h4 class="text-yellow-400 font-bold mb-6 text-sm tracking-widest uppercase">Síguenos</h4>
                                <div class="flex gap-5 flex-wrap">
                                    <a href="https://www.facebook.com/superinka" target="_blank" rel="noopener noreferrer" class="group bg-white/10 border border-white/20 p-3 rounded-full transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(250,204,21,0.2)] flex items-center justify-center w-12 h-12 hover:bg-yellow-400 hover:border-yellow-400 text-white">
                                        <Image src={logoFb} alt="Facebook" class="w-full h-full object-contain filter group-hover:brightness-0" />
                                    </a>
                                    <a href="https://www.instagram.com/qoribex/" target="_blank" rel="noopener noreferrer" class="group bg-white/10 border border-white/20 p-3 rounded-full transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(250,204,21,0.2)] flex items-center justify-center w-12 h-12 hover:bg-yellow-400 hover:border-yellow-400 text-white">
                                        <Image src={logoIg} alt="Instagram" class="w-full h-full object-cover rounded-full filter group-hover:brightness-0" />
                                    </a>
                                    <a href="https://www.linkedin.com/company/qoribex" target="_blank" rel="noopener noreferrer" class="group bg-white/10 border border-white/20 p-3 rounded-full transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(250,204,21,0.2)] flex items-center justify-center w-12 h-12 hover:bg-yellow-400 hover:border-yellow-400 text-white">
                                        <Image src={logoLi} alt="LinkedIn" class="w-full h-full object-contain filter group-hover:brightness-0 group-hover:invert-0" />
                                    </a>
                                    <a href="https://x.com/Qoribex" target="_blank" rel="noopener noreferrer" class="group bg-white/10 border border-white/20 p-3 rounded-full transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(250,204,21,0.2)] flex items-center justify-center w-12 h-12 hover:bg-yellow-400 hover:border-yellow-400 text-white">
                                        <Image src={logoX} alt="X" class="w-full h-full object-contain filter group-hover:brightness-0 group-hover:invert" />
                                    </a>
                                    <a href="https://www.youtube.com/@Qoribex" target="_blank" rel="noopener noreferrer" class="group bg-white/10 border border-white/20 p-3 rounded-full transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(250,204,21,0.2)] flex items-center justify-center w-12 h-12 hover:bg-yellow-400 hover:border-yellow-400 text-white">
                                        <Image src={logoYt} alt="YouTube" class="w-full h-full object-contain filter group-hover:brightness-0 group-hover:invert" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Bottom -->
                <div class="flex flex-col md:flex-row justify-between items-center text-sm text-blue-300/60 gap-4">
                    <p>&copy; {new Date().getFullYear()} Qoribex Agencia Digital. Todos los derechos reservados.</p>
                    <div class="flex gap-8">
                        <a href="#" class="hover:text-white transition-colors">Política de Privacidad</a>
                        <a href="#" class="hover:text-white transition-colors">Términos y Condiciones</a>
                    </div>
                </div>
            </div>
        </footer>

        <!-- TOAST DE NOTIFICACIÓN (MEJORA UX) -->
        <div id="successToast" class="fixed bottom-8 right-8 md:bottom-12 md:right-12 bg-white rounded-2xl shadow-[0_20px_50px_-12px_rgba(31,35,163,0.3)] border-l-4 border-yellow-400 p-6 transform translate-y-[200%] opacity-0 transition-all duration-700 z-[100] flex items-start gap-4 max-w-sm pointer-events-none">
            <div class="bg-blue-50 p-3 rounded-full flex-shrink-0 mt-1">
                <span class="text-2xl drop-shadow-sm">🚀</span>
            </div>
            <div>
                <h4 class="text-[#1F23A3] font-black text-xl leading-tight mb-1">¡Datos Capturados!</h4>
                <p id="toastMessage" class="text-gray-600 text-sm leading-relaxed">Generando conexión segura...</p>
            </div>
        </div>

        <!-- SCRIPT PARA MANEJAR EL FORMULARIO (WHATSAPP - PRODUCCIÓN) -->
        <script>
            const form = document.getElementById('contactForm');
            const toast = document.getElementById('successToast');
            const toastMessage = document.getElementById('toastMessage');

            if (form && toast && toastMessage) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    
                    const currentForm = e.currentTarget;
                    if (!(currentForm instanceof HTMLFormElement)) return;

                    const submitter = e.submitter;
                    const metodoContacto = (submitter instanceof HTMLButtonElement) ? submitter.value : 'whatsapp';

                    const formData = new FormData(currentForm);
                    const data = Object.fromEntries(formData.entries());
                    const fullPhone = data.countryCode + " " + data.phone;
                    
                    if (metodoContacto === 'whatsapp') {
                        const numeroQoribex = "51972594948"; 
                        const mensajeWsp = `Hola equipo Qoribex.\n\nSoy *${data.name}* y estoy interesado/a en iniciar un proyecto de *${data.service}* con ustedes.\n\nPor favor, contáctenme a través de mi correo de respaldo:\n• Correo: ${data.email}\n\n¡Quedo a la espera de su respuesta!`;
                        
                        const whatsappUrl = `https://wa.me/${numeroQoribex}?text=${encodeURIComponent(mensajeWsp)}`;
                        
                        toastMessage.innerHTML = `Conectando con WhatsApp, <b>${data.name}</b>...`;
                        toast.classList.remove('translate-y-[200%]', 'opacity-0');
                        
                        setTimeout(() => {
                            window.open(whatsappUrl, '_blank');
                            setTimeout(() => {
                                toast.classList.add('translate-y-[200%]', 'opacity-0');
                                currentForm.reset();
                            }, 1000);
                        }, 1500);

                    } else if (metodoContacto === 'email') {
                        const correoDestino = "hola@qoribex.com";
                        const asunto = `Nuevo prospecto web: ${data.name} - ${data.service}`;
                        const cuerpoMensaje = `Hola equipo Qoribex,\n\nMi nombre es ${data.name} y estoy interesado/a en iniciar un proyecto de ${data.service} con ustedes.\n\nMis datos de contacto son:\n• Teléfono: ${fullPhone}\n• Correo: ${data.email}\n\n¡Quedo a la espera de su respuesta para conversar los detalles!`;
                        
                        const mailtoUrl = `mailto:${correoDestino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpoMensaje)}`;
                        
                        toastMessage.innerHTML = `Preparando tu correo, <b>${data.name}</b>...`;
                        toast.classList.remove('translate-y-[200%]', 'opacity-0');
                        
                        setTimeout(() => {
                            window.location.href = mailtoUrl;
                            setTimeout(() => {
                                toast.classList.add('translate-y-[200%]', 'opacity-0');
                                currentForm.reset();
                            }, 1000);
                        }, 1500);
                    }
                });
            }
        </script>

    </main>
</Layout>

